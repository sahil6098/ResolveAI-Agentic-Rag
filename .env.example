# ─────────────────────────────────────────────────────────────────────────────
# Resolve-AI — Environment Variables Example
# Copy this file to .env and fill in your own values.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────


# ── LLM Provider ──────────────────────────────────────────────────────────────
# Groq API key — get yours at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq model to use for inference
# Available models: https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-20b


# ── Web Search ────────────────────────────────────────────────────────────────
# Tavily API key — get yours at https://app.tavily.com/
TAVILY_API_KEY=tvly-your_tavily_api_key_here


# ── Vector Store (Pinecone) ───────────────────────────────────────────────────
# Pinecone API key — get yours at https://app.pinecone.io/
PINECONE_API_KEY=pcsk_your_pinecone_api_key_here

# Name of the Pinecone index to use (must exist in your Pinecone project)
PINECONE_INDEX_NAME=fde-it-support-rag

# Namespace within the index for scoping knowledge-base documents
PINECONE_NAMESPACE=company-it-kb


# ── Embedding Model ───────────────────────────────────────────────────────────
# HuggingFace sentence-transformers model used to embed documents & queries
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2


# ── Security ──────────────────────────────────────────────────────────────────
# Secret key used to protect admin API endpoints — change this before deploying!
ADMIN_KEY_API=change-me-to-a-strong-random-secret
